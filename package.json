{
  "name": "quantapit",
  "description": "Local-first quantitative and market interview training platform.",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "typescript": "latest",
    "vite": "~8.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^24.19.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "latest",
    "vitest": "~4.1.12"
  }
}
